# Copy to .env beside compose.yml (cp env.example .env). Every setting is
# optional; `sheprd-relay --help` lists them all.

# Turns the dashboard on at https://RELAY_DOMAIN/dashboard (12+ characters).
RELAY_DASHBOARD_PASSWORD=
RELAY_DASHBOARD_USER=admin

# Limits. Defaults suit a 1 GB droplet.
# RELAY_MAX_CONNECTIONS=10000
# RELAY_MAX_CONNECTIONS_PER_IP=64
# RELAY_MAX_LISTENERS=5000
# RELAY_MAX_SESSIONS=5000
# RELAY_MAX_SESSIONS_PER_ROUTE=32
# RELAY_SESSION_BANDWIDTH=4MiB
# RELAY_TOTAL_BANDWIDTH=0
# RELAY_IDLE_TIMEOUT=5m
# RELAY_MAX_SESSION_DURATION=24h

# Only computers presenting this token may listen (16+ characters).
# RELAY_LISTEN_TOKEN=

# Require `Authorization: Bearer TOKEN` on /metrics (16+ characters).
# RELAY_METRICS_TOKEN=
