# The title of a system notification: a Herdr 2 agent waits on the user,
# for a permission, a question, or an error. $agent is the agent's name,
# such as "Claude".
core-notifications-needs-you = { $agent } needs you
# The title of a system notification: a Herdr 2 agent's turn ended.
core-notifications-finished = { $agent } finished
# What a notification calls an agent that reports no name.
core-notifications-agent = Agent
