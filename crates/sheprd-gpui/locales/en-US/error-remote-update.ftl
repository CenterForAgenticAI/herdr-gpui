# Failures reading or updating Sheprd on another machine from this app.

error-remote-update-answer = Sheprd's answer on that machine is not one this app can read
error-remote-update-missing = Sheprd is not installed on that machine
error-remote-update-not-running = Sheprd is not running on that machine
# $reason is Sheprd's own message on that machine, in English.
error-remote-update-refused = Sheprd on that machine refused: { $reason }
error-remote-update-run = Could not run Sheprd on that machine: { $reason }
error-remote-update-timeout = Sheprd on that machine did not finish updating in time
error-remote-update-too-old = Sheprd on that machine is too old to be updated from here; update it there once
# $reason is what the machine's updater reported, in English.
error-remote-update-update = Sheprd on that machine could not update: { $reason }
