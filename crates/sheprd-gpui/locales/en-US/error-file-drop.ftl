# Why dropped or pasted paths could not be quoted for a pane.

error-file-drop-control = Dropped paths must not contain control characters.
error-file-drop-empty-path = Dropped paths must not be empty.
error-file-drop-encoding = Dropped paths must be UTF-8.
error-file-drop-other-host = Files on this computer cannot be dropped into another host's Herdr 2 terminal.
error-file-drop-size = File drop exceeds 256 paths or 64 KiB of quoted text.
